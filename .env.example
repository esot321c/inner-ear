# Configuration for Inner Ear.
# Copy this file to ".env" and fill in what you need. ".env" is gitignored.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env

# --- HuggingFace token ---
# NOT needed for the main app: Whisper, NeMo Sortformer, and DiCoW are all open
# models that download without auth.
# ONLY needed for the optional pyannote research backend in the stage bench
# (docker compose --profile bench up bench), because pyannote's models are gated:
#   1. Free account: https://huggingface.co/join
#   2. Accept the terms while logged in:
#        https://huggingface.co/pyannote/speaker-diarization-3.1
#        https://huggingface.co/pyannote/segmentation-3.0
#   3. Create a READ token: https://huggingface.co/settings/tokens
HF_TOKEN=

# --- optional app settings (defaults shown) ---
# WHISPER_MODEL=large-v3      # or large-v3-turbo for speed
# DICOW_MIN_SPK=3             # auto-escalate to DiCoW at this many speakers on a track; set high (99) to disable

# --- optional: extra LLM boundary-cleanup pass on the cascade path ---
# Point at any OpenAI-compatible endpoint (e.g. a local Ollama).
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:7b
