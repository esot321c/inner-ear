# Configuration for the transcription tools.
# Copy this file to ".env" and fill in what you need. ".env" is gitignored.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env

# --- HuggingFace token ---
# NOT needed for the main app (Transcribe-App.bat): Whisper + NeMo Sortformer
# are open models and download without auth.
# ONLY needed for the LEGACY pyannote launchers (Transcribe-Folder.bat /
# Transcribe-Docker.bat), because pyannote's diarization models are gated.
#
# To get one (legacy path only):
#   1. Make a free account: https://huggingface.co/join
#   2. Accept the model terms while logged in:
#        https://huggingface.co/pyannote/speaker-diarization-3.1
#        https://huggingface.co/pyannote/segmentation-3.0
#   3. Create a READ token: https://huggingface.co/settings/tokens
#   4. Paste it below.
HF_TOKEN=

# --- optional app/CLI settings (defaults used if left blank) ---
# WHISPER_MODEL=large-v3      # or large-v3-turbo for speed
# YOU_NAME=You                # label for your own mic channel
# YOU_CH=0                    # which channel/track is you (0 or 1) for dual files
