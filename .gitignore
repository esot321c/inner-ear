# --- secrets / local config (never commit) ---
.env
hf_token.txt
# (.env.example IS committed as the template)

# --- python environment / caches ---
.venv/
__pycache__/
*.pyc

# --- bundled binaries (large, machine-specific) ---
bin/

# --- data folders (your audio + transcripts, large/private) ---
# Keep the in/ folder in a fresh clone (drop audio here) but ignore its contents.
in/*
!in/.gitkeep
out/
archive/
scratch/

# --- model caches ---
*.cache/

# --- logs and build artifacts ---
*.log
logs/
docker/nemo/audio.wav
docker/nemo/out/

# --- tooling caches / scratch ---
.pytest_cache/
.playwright-mcp/

# --- local working docs (specs, plans, lab notebook) - kept on disk, not in the repo ---
docs/

# --- my throwaway scratch scripts ---
_*.py

# --- OS cruft ---
Thumbs.db
desktop.ini
.DS_Store
